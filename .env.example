# Fresh Testagram runtime — Appwrite identity/data + Go Backend + B2/R2 media.
# Local development only. Never commit real credentials or provider secrets.

FRESH_API_ADDR=:8081
FRESH_API_ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site,http://localhost:5173,http://127.0.0.1:5173

# Appwrite is the only identity provider in the fresh runtime.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_SERVER_API_KEY=

# Private Federation service authentication. Use the same random token in the
# Backend and Federation services. Never expose it to XClone or mobile clients.
FRESH_FEDERATION_INTERNAL_TOKEN=

# Shared only with the trusted identity-verification issuer. Keep this secret
# server-side in both the identity issuer and Backend; never expose it to XClone.
IDENTITY_PREAUTH_SECRET=

# Private Algorithm service. Leave both blank to use chronological fallback.
ALGORITHM_ENDPOINT=
ALGORITHM_INTERNAL_TOKEN=
FEED_RANKING_REQUIRED=false

# Content moderation is fail-closed for publishing when not configured.
ONSPACE_AI_BASE_URL=https://ai.onspace.ai/v1
ONSPACE_AI_API_KEY=

# Media lifecycle is deliberately disabled until B2/R2 credentials, Appwrite
# collections/indexes, read-back verification, and restore tests are staged.
FRESH_MEDIA_ENABLED=false
TESTAGRAM_STORAGE_POOL_BYTES=150000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648

# Backblaze B2 is the primary private object origin (S3-compatible API).
B2_S3_ENDPOINT=
B2_S3_REGION=us-west-004
B2_S3_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=

# Cloudflare R2 is the verified second replica and optional delivery origin.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Independent cold archive. This must use a distinct bucket/provider target.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Retention is always dry-run/disabled during initial deployment.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true
