# Local development only. Never commit real credentials.
POSTGRES_DB=testagram
POSTGRES_USER=testagram
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgres://testagram:replace-with-a-long-random-local-password@db:5432/testagram?sslmode=disable
LISTEN_ADDR=:8080
DB_MAX_CONNS=10

# Optional upstream capability gateway config. Publishable key only; never put a service-role key here.
SUPABASE_URL=https://ffrhglgkukgsuhxenena.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site,http://localhost:5173,http://127.0.0.1:5173

# Virtual storage is opt-in until CDN path mapping and provider integration tests pass.
VIRTUAL_STORAGE_ENABLED=false

# Media storage: use Cloudflare R2 S3 API credentials. Keep public and private
# buckets separate; only the public bucket should be served by media.testagram.site.
MEDIA_S3_ENDPOINT=https://replace-with-r2-account-id.r2.cloudflarestorage.com
MEDIA_S3_SIGNING_HOST=replace-with-r2-account-id.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=auto
MEDIA_PRIVATE_BUCKET=testagram-private-media
MEDIA_PUBLIC_BUCKET=testagram-public-media
MEDIA_PUBLIC_BASE_URL=https://media.testagram.site/v1

# Server-only Supabase service-role key for product media metadata bridging.
# Never expose this variable to Vite/browser code.
SUPABASE_SERVICE_ROLE_KEY=
