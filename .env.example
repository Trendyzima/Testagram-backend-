# Local development only. Never commit real credentials.
POSTGRES_DB=testagram
POSTGRES_USER=testagram
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgres://testagram:replace-with-a-long-random-local-password@db:5432/testagram?sslmode=disable
LISTEN_ADDR=:8080
DB_MAX_CONNS=10

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1 # Must match the Appwrite project's actual region
APPWRITE_PROJECT_ID= # Set the actual Appwrite project ID; do not use the database ID
APPWRITE_DATABASE_ID=6af01f05003503d9d603
APPWRITE_SERVER_API_KEY= # Server-only key with least-privilege metadata/document scopes

ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site,http://localhost:5173,http://127.0.0.1:5173

# Virtual storage is opt-in until CDN path mapping and provider integration tests pass.
VIRTUAL_STORAGE_ENABLED=false

# Media storage: any tested S3-compatible provider (Backblaze B2, Cloudflare R2, or local MinIO).
# For B2 use its S3 endpoint for the selected bucket region and the provider region below.
# Keep public and private buckets separate; never use a browser-visible credential.
MEDIA_S3_ENDPOINT=
MEDIA_S3_SIGNING_HOST=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=us-east-1
MEDIA_PRIVATE_BUCKET=testagram-private-media
MEDIA_PUBLIC_BUCKET=testagram-public-media
MEDIA_PUBLIC_BASE_URL=https://media.testagram.site/v1

# Optional private CDN delivery. Generate a dedicated random secret (32+ bytes); never reuse storage/Appwrite/Federation credentials.
CDN_MEDIA_ASSERTION_SECRET=
CDN_MEDIA_BASE_URL=https://media.testagram.site
CDN_ORIGIN_AUTH_TOKEN=


# Private Testagram ranking service. Configure only when the API and ranker share a private network. Leave blank for chronological fallback.
ALGORITHM_URL=
ALGORITHM_INTERNAL_TOKEN=

# Backend -> Federation publisher (transactional outbox delivery).
# FEDERATION_INTERNAL_TOKEN must match Federation's FEDERATION_INGRESS_TOKEN.
FEDERATION_INTERNAL_URL=http://federation:8081
FEDERATION_INTERNAL_TOKEN=

# Federation -> Backend private inbound service authentication.
# FEDERATION_BACKEND_INTERNAL_TOKEN must match Federation's BACKEND_INTERNAL_TOKEN.
# Keep this secret distinct from FEDERATION_INTERNAL_TOKEN.
FEDERATION_BACKEND_INTERNAL_TOKEN=
