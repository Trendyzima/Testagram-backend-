FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/fresh-api ./cmd/fresh-api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/fresh-api /fresh-api
EXPOSE 8081
USER nonroot:nonroot
ENTRYPOINT ["/fresh-api"]
