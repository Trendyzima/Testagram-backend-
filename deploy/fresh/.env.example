# Fresh Testagram only. Use a separate Appwrite project/database per environment.
FRESH_API_ADDR=:8081
# Comma-separated exact frontend HTTPS origins; wildcard origins are rejected.
FRESH_API_ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
# Leave false until the fresh Appwrite storage collections and indexes are provisioned.
FRESH_MEDIA_ENABLED=false
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID= # Set the actual Appwrite project ID
APPWRITE_DATABASE_ID=6af01f05003503d9d603
# Dedicated server-only key: users.read, documentsdb.documents.read, documentsdb.documents.write,
# plus documentsdb.collections.read and documentsdb.indexes.read for readiness checks.
# Keep this value only in Render/secret storage; never commit it.
APPWRITE_SERVER_API_KEY=

# Neon PostgreSQL is the canonical social data plane. The API consumes DATABASE_URL.
# Use the Neon pooled connection string (sslmode=require); never commit real credentials.
DATABASE_URL=
NEON_REQUIRED=true

# Fresh post moderation. Without a provider key, the Backend refuses post writes.
ONSPACE_AI_BASE_URL=https://ai.onspace.ai/v1
ONSPACE_AI_API_KEY=

# Optional private feed ranking. Backend alone calls Algorithm; never expose this token to XClone.
ALGORITHM_ENDPOINT=http://algorithm:8092
ALGORITHM_INTERNAL_TOKEN=
FEED_RANKING_REQUIRED=false

# Two independent active object-storage providers. Both store complete media objects.
# Select the upload origin per reservation. Both providers always receive verified full copies.
# Set to b2 (default) or r2; the chosen origin is persisted with each reservation.
FRESH_MEDIA_PRIMARY_PROVIDER=b2

# Backblaze B2 is an active object-storage provider.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_S3_REGION=us-east-005
B2_S3_BUCKET=audiostrendy
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=

# Cloudflare R2 is a real second object store, not merely a CDN cache.
# Backend copies every verified B2 upload into this private R2 bucket and verifies SHA-256 read-back.
CLOUDFLARE_R2_ENDPOINT=https://77dbe7a859196105dc84fbb6b7094019.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=testagram-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Optional private-media Cloudflare Worker delivery URL and shared signing secret.
CLOUDFLARE_MEDIA_BASE_URL=https://media.testagram.site
CLOUDFLARE_MEDIA_SIGNING_SECRET=

# Cloudflare zone is for DNS/CDN/WAF management outside the media API.
# These do not replace the R2 S3 credentials above.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Logical quota target. Decimal bytes: 150 GB logical capacity.
# Quotas are atomically reserved in KiB (round up each upload).
TESTAGRAM_STORAGE_POOL_BYTES=150000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648

# Optional independent cold-archive provider. Required before archive jobs can run.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Retention remains fail-closed until explicitly configured.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true
TESTAGRAM_RETENTION_START_AT=
TESTAGRAM_STORY_TTL_HOURS=24
TESTAGRAM_MEDIA_ARCHIVE_AFTER_DAYS=30
TESTAGRAM_USER_DELETION_RECOVERY_DAYS=30
TESTAGRAM_RETENTION_BATCH_SIZE=100

# Optional: mount the private Backend-to-Federation outbox API only when Federation is ready.
FRESH_FEDERATION_INTERNAL_TOKEN=
