# Fresh Testagram only. Use a separate Appwrite project/database per environment.
FRESH_API_ADDR=:8081
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_SERVER_API_KEY=

# Object storage providers are private; credentials never go to frontend builds.
# B2 is the first durable origin.
B2_S3_ENDPOINT=
B2_S3_REGION=us-west-004
B2_S3_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=

# R2 is the additional object provider / independently verified replica target.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_MEDIA_HOST=

# Cloudflare zone is for DNS/CDN/WAF. CDN cache is not storage capacity.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Logical quota target. Decimal bytes: 100 GB.
TESTAGRAM_STORAGE_POOL_BYTES=100000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648
