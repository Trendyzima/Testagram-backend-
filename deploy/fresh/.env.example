# Fresh Testagram only. Use a separate Appwrite project/database per environment.
FRESH_API_ADDR=:8081
# Comma-separated exact frontend HTTPS origins; wildcard origins are rejected.
FRESH_API_ALLOWED_ORIGINS=
# Leave false until the fresh Appwrite storage collections and indexes are provisioned.
FRESH_MEDIA_ENABLED=false
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_SERVER_API_KEY=

# Object storage providers are private; credentials never go to frontend builds.
# B2 is the first durable origin.
B2_S3_ENDPOINT=
B2_S3_REGION=us-west-004
B2_S3_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=

# R2 is the additional object provider / independently verified replica target.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
# Optional private-media Cloudflare Worker URL signing. Configure only after deploying cloudflare/media-worker.
CLOUDFLARE_MEDIA_BASE_URL=
CLOUDFLARE_MEDIA_SIGNING_SECRET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Cloudflare zone is for DNS/CDN/WAF management outside the media API. CDN cache is not storage capacity.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Logical quota target. Decimal bytes: 150 GB logical capacity.
# Quotas are atomically reserved in KiB (round up each upload).
TESTAGRAM_STORAGE_POOL_BYTES=150000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648

# Retention lifecycle. Safe defaults: disabled and dry-run; no retroactive processing.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true
# Set only after policy approval; records created before this UTC timestamp are never selected.
TESTAGRAM_RETENTION_START_AT=
TESTAGRAM_STORY_TTL_HOURS=24
TESTAGRAM_MEDIA_ARCHIVE_AFTER_DAYS=30
TESTAGRAM_USER_DELETION_RECOVERY_DAYS=30
TESTAGRAM_RETENTION_BATCH_SIZE=100
# Archive provider/bucket must be configured separately and verified before archive jobs can run.
TESTAGRAM_ARCHIVE_PROVIDER=
TESTAGRAM_ARCHIVE_BUCKET=
