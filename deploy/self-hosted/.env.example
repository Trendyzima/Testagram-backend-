# Copy to .env, replace placeholders, then chmod 600 .env.
POSTGRES_DB=testagram
POSTGRES_USER=testagram
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD
DB_MAX_CONNS=20
VPS_INTERNAL_TOKEN=REPLACE_WITH_LONG_RANDOM_VPS_INTERNAL_TOKEN
VPS_NODE_BOOTSTRAP_TOKEN=REPLACE_WITH_LONG_RANDOM_NODE_BOOTSTRAP_TOKEN
# Explicitly approve exact immutable image@sha256 references before enabling workload execution.
# Empty/default denies scheduling; keep this empty until the node agent enforces the same allowlist.
VPS_ALLOWED_WORKLOAD_IMAGES=
# Configure only after confirming the public zone and origin address.
TESTAGRAM_BASE_DOMAIN=
TESTAGRAM_DOMAIN=
TESTAGRAM_PUBLIC_ORIGIN_IP=
# Comma-separated allowlist of service=private-origin entries; never accept user-supplied URLs.
TESTAGRAM_DOMAIN_TARGETS=
MINIO_ROOT_USER=testagram-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=testagram-private-media
PUBLIC_MEDIA_BUCKET=testagram-public-media
# Restricted S3 identity used only to sign media upload/download URLs; never use the MinIO root credentials in the API.
MINIO_MEDIA_ACCESS_KEY=testagram-media-api
MINIO_MEDIA_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_MEDIA_SIGNING_SECRET
# Enable the private Instabox VPS object-storage adapter used by profile avatars.
# Keep MEDIA_S3_* blank to use the bundled MinIO endpoint and MINIO_MEDIA_* credentials.
VIRTUAL_STORAGE_ENABLED=true

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=REPLACE_WITH_APPWRITE_PROJECT_ID

# Optional private service integrations. Keep tokens identical to the Data Centre overlay.
# Leave blank only for a Backend-only development deployment.
ALGORITHM_URL=http://algorithm:8092
ALGORITHM_INTERNAL_TOKEN=REPLACE_WITH_SHARED_RANDOM_32_BYTE_RANKER_TOKEN
FEDERATION_INTERNAL_URL=http://federation-api:8081
FEDERATION_PUBLIC_BASE_URL=https://federation.testagram.site
# Backend -> Federation activity ingress credential (distinct from the reverse direction).
FEDERATION_INGRESS_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_FEDERATION_INGRESS_TOKEN
# Federation -> Backend actor/readiness credential.
FEDERATION_BACKEND_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_FEDERATION_BACKEND_TOKEN
# Keep FEDERATION_INTERNAL_TOKEN and FEDERATION_BACKEND_INTERNAL_TOKEN independently generated; no shared-token fallback is accepted.
APPWRITE_API_KEY=REPLACE_WITH_SERVER_ONLY_APPWRITE_USERS_WRITE_KEY
# Optional external S3 provider; leave blank to use the bundled MinIO deployment.
MEDIA_S3_ENDPOINT=
MEDIA_S3_SIGNING_HOST=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=us-east-1
MEDIA_PRIVATE_BUCKET=testagram-private-media
MEDIA_PUBLIC_BUCKET=testagram-public-media
MINIO_PUBLIC_ENDPOINT=https://media.testagram.site
# Public object URL prefix must include the public bucket path used by the media edge.
MEDIA_PUBLIC_BASE_URL=https://media.testagram.site/v1
MINIO_REGION=us-east-1
ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
API_DOMAIN=api.testagram.site
MEDIA_DOMAIN=media.testagram.site
ACME_EMAIL=ops@example.com

# Staff console is served over HTTPS by Caddy. Generate with: openssl rand -hex 32
ADMIN_DOMAIN=ops.testagram.site
ADMIN_PUBLIC_URL=https://ops.testagram.site
ADMIN_SESSION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_KEY
# Shared only by trusted backend services over the private platform network. Generate independently from ADMIN_SESSION_KEY.
ADMIN_SERVICE_AUTH_KEY=REPLACE_WITH_ANOTHER_64_HEX_CHAR_RANDOM_KEY
ADMIN_COOKIE_SECURE=true
GRAFANA_URL=http://127.0.0.1:3000

# Grafana is bound to 127.0.0.1:3000; access remotely through an SSH tunnel.
GRAFANA_ADMIN_USER=testagram-ops
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_GRAFANA_PASSWORD

# Optional operator-controlled Alertmanager webhook. Blank means alerts are evaluated but not delivered externally.
# Treat this URL as a secret and never commit the real value.
ALERTMANAGER_WEBHOOK_URL=


# Per-account media quota; defaults to 2 GiB including active upload reservations.
MEDIA_USER_QUOTA_BYTES=2147483648
# Optional operator-only takedown token. Generate a long random value; blank disables quarantine actions.
MEDIA_MODERATION_TOKEN=

# Safaricom Daraja STK Push. Leave credentials blank until the business account is approved.
# Use sandbox for testing; switch to live only after callback verification and settlement smoke tests.
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://api.testagram.site/api/wallet/mpesa/callback


# Enable only after all three object stores and the media replication migrations are verified.
MEDIA_REPLICATION_ENABLED=false
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PRIVATE_BUCKET=
CLOUDFLARE_R2_PUBLIC_BUCKET=
B2_S3_ENDPOINT=
B2_S3_REGION=us-east-005
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
B2_S3_PRIVATE_BUCKET=
B2_S3_PUBLIC_BUCKET=

# Shared only between Fresh API and Backend; never expose to clients.
FRESH_MEDIA_INTERNAL_TOKEN=
