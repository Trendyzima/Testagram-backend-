# Copy to .env, replace placeholders, then chmod 600 .env.
POSTGRES_DB=testagram
POSTGRES_USER=testagram
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD
DB_MAX_CONNS=20
VALKEY_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALKEY_PASSWORD
VALKEY_MAXMEMORY=512mb
PLATFORM_INTERNAL_TOKEN=REPLACE_WITH_LONG_RANDOM_PLATFORM_INTERNAL_TOKEN
VPS_INTERNAL_TOKEN=REPLACE_WITH_LONG_RANDOM_VPS_INTERNAL_TOKEN
VPS_NODE_BOOTSTRAP_TOKEN=REPLACE_WITH_LONG_RANDOM_NODE_BOOTSTRAP_TOKEN
# Explicitly approve exact immutable image@sha256 references before enabling workload execution.
# Empty/default denies scheduling; keep this empty until the node agent enforces the same allowlist.
VPS_ALLOWED_WORKLOAD_IMAGES=
# Configure only after confirming the public zone and origin address.
TESTAGRAM_BASE_DOMAIN=
TESTAGRAM_DOMAIN=
TESTAGRAM_PUBLIC_ORIGIN_IP=
# Comma-separated allowlist of service=private-origin entries; never accept user-supplied URLs.
TESTAGRAM_DOMAIN_TARGETS=
MINIO_ROOT_USER=testagram-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=testagram-private-media
PUBLIC_MEDIA_BUCKET=testagram-public-media
# Restricted S3 identity used only to sign media upload/download URLs; never use the MinIO root credentials in the API.
MINIO_MEDIA_ACCESS_KEY=testagram-media-api
MINIO_MEDIA_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_MEDIA_SIGNING_SECRET
# Leave disabled until the public CDN/origin serves tenant-prefixed object paths and end-to-end tests pass.
VIRTUAL_STORAGE_ENABLED=false
MINIO_PUBLIC_ENDPOINT=https://media.testagram.site
# Public object URL prefix must include the public bucket path used by the media edge.
MEDIA_PUBLIC_BASE_URL=https://media.testagram.site/testagram-public-media
MINIO_REGION=us-east-1
# The capability gateway still needs a compatible Supabase API.
SUPABASE_URL=
# Server-only key for synchronizing media_assets/post_media rows. Never put this in browser/mobile env.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
API_DOMAIN=api.testagram.site
MEDIA_DOMAIN=media.testagram.site
ACME_EMAIL=ops@example.com

# Optional queue monitoring: comma-separated queue:consumer-group pairs.
PLATFORM_MONITORED_QUEUE_GROUPS=

# Per-account media quota; defaults to 2 GiB including active upload reservations.
MEDIA_USER_QUOTA_BYTES=2147483648
# Optional operator-only takedown token. Generate a long random value; blank disables quarantine actions.
MEDIA_MODERATION_TOKEN=
