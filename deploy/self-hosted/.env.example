# Copy to .env, replace placeholders, then chmod 600 .env.
POSTGRES_DB=testagram
POSTGRES_USER=testagram
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD
DB_MAX_CONNS=20
VPS_INTERNAL_TOKEN=REPLACE_WITH_LONG_RANDOM_VPS_INTERNAL_TOKEN
VPS_NODE_BOOTSTRAP_TOKEN=REPLACE_WITH_LONG_RANDOM_NODE_BOOTSTRAP_TOKEN
# Explicitly approve exact immutable image@sha256 references before enabling workload execution.
# Empty/default denies scheduling; keep this empty until the node agent enforces the same allowlist.
VPS_ALLOWED_WORKLOAD_IMAGES=
# Configure only after confirming the public zone and origin address.
TESTAGRAM_BASE_DOMAIN=
TESTAGRAM_DOMAIN=
TESTAGRAM_PUBLIC_ORIGIN_IP=
# Comma-separated allowlist of service=private-origin entries; never accept user-supplied URLs.
TESTAGRAM_DOMAIN_TARGETS=
MINIO_ROOT_USER=testagram-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=testagram-private-media
PUBLIC_MEDIA_BUCKET=testagram-public-media
# Restricted S3 identity used only to sign media upload/download URLs; never use the MinIO root credentials in the API.
MINIO_MEDIA_ACCESS_KEY=testagram-media-api
MINIO_MEDIA_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_MEDIA_SIGNING_SECRET
# Enable the private Instabox VPS object-storage adapter used by profile avatars.
# Keep MEDIA_S3_* blank to use the bundled MinIO endpoint and MINIO_MEDIA_* credentials.
VIRTUAL_STORAGE_ENABLED=true
MINIO_METADATA_BUCKET=testagram-media-metadata
# Dedicated least-privilege key for Data Centre metadata sidecars only.
MINIO_METADATA_ACCESS_KEY=testagram-metadata-sidecar
MINIO_METADATA_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_METADATA_BUCKET_SECRET
# Native identity intake is hard-disabled in API code until private B2/R2 replication, reviewer access, real staff WebAuthn MFA, dual approval and email delivery pass acceptance.
TESTAGRAM_TERMS_VERSION=2026-11-11
TESTAGRAM_PRIVACY_VERSION=2026-11-11

# Testagram-native HS256 signing secret. Generate independently: openssl rand -hex 32
# Use the same value in Backend and private Data Centre service environments.
TESTAGRAM_AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

AUTH_PUBLIC_BASE_URL=https://testagram.site
# Testagram-native transactional and notification email runs directly from InstaBox.
# The deployment script generates/persists the keys on the VPS; do not add provider credentials.
# Keep the VERP key stable until all outstanding return-path tokens have expired.
TESTAGRAM_MAIL_ENCRYPTION_KEY=
TESTAGRAM_MAIL_VERP_KEY=
TESTAGRAM_MAIL_DELIVERY_ENABLED=true
TESTAGRAM_DKIM_PRIVATE_KEY_FILE=/run/testagram-mail/dkim-private.pem
TESTAGRAM_DKIM_SELECTOR=tg2026
TESTAGRAM_MAIL_BOUNCE_LISTEN_ADDR=:2525
TESTAGRAM_MAIL_TLS_CERT_FILE=
TESTAGRAM_MAIL_TLS_KEY_FILE=


# Optional private service integrations. Keep tokens identical to the Data Centre overlay.
# Leave blank only for a Backend-only development deployment.
ALGORITHM_URL=http://algorithm:8092
ALGORITHM_INTERNAL_TOKEN=REPLACE_WITH_SHARED_RANDOM_32_BYTE_RANKER_TOKEN
FEDERATION_INTERNAL_URL=http://federation-api:8081
FEDERATION_PUBLIC_BASE_URL=https://testagram.site
# Backend -> Federation activity ingress credential (distinct from the reverse direction).
FEDERATION_INGRESS_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_FEDERATION_INGRESS_TOKEN
# Federation -> Backend actor/readiness credential.
FEDERATION_BACKEND_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_FEDERATION_BACKEND_TOKEN
# Keep FEDERATION_INTERNAL_TOKEN and FEDERATION_BACKEND_INTERNAL_TOKEN independently generated; no shared-token fallback is accepted.
# Optional external S3 provider; leave blank to use the bundled MinIO deployment.
MEDIA_S3_ENDPOINT=
MEDIA_S3_SIGNING_HOST=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=us-east-1
MEDIA_PRIVATE_BUCKET=testagram-private-media
MEDIA_PUBLIC_BUCKET=testagram-public-media
# Despite the legacy name, this is the private Docker endpoint used for SigV4 signing.
MINIO_PUBLIC_ENDPOINT=http://object-storage:9000
# Public object URL prefix must include the public bucket path used by the media edge.
MEDIA_PUBLIC_BASE_URL=https://media.testagram.site/v1
# Go CDN image is pinned to the verified immutable build from CDN main.
TESTAGRAM_CDN_IMAGE=ghcr.io/trendyzima/testagram-edge@sha256:37c7c68088bf3a6b04a243d3d0cf3c64633b33ac4d767775911808707eeda865
# Deployment resolves this moving release tag to an immutable digest before Compose starts.
TESTAGRAM_WEB_IMAGE=ghcr.io/trendyzima/testagram-web@sha256:3aa39a426322cbfda5d6dbf8d252cc09a8748ec1e99923e70e7e7ed1f45a8b53
CDN_MEDIA_BASE_URL=https://media.testagram.site
CDN_ORIGIN_AUTH_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_BYTE_ORIGIN_TOKEN
# Shared only between the Cloudflare API Worker and Caddy :8443 API ingress.
# Generate with: openssl rand -hex 32. Also store the same value as the
# Dedicated 32-byte random hex capability shared only with the Cloudflare recovery Worker.
# Do not reuse TESTAGRAM_EDGE_PROXY_SHARED_TOKEN or any JWT/signing secret.
TESTAGRAM_EDGE_RECOVERY_READINESS_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_BYTE_HEX_SECRET

# GitHub Actions secret TESTAGRAM_EDGE_PROXY_SHARED_TOKEN.
EDGE_PROXY_SHARED_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_BYTE_EDGE_TOKEN
CDN_MEDIA_ASSERTION_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_32_BYTE_ASSERTION_SECRET
CDN_PURGE_TOKEN=REPLACE_WITH_A_THIRD_SEPARATE_RANDOM_32_BYTE_PURGE_TOKEN
CDN_NODE_ID=instabox-edge-1
CDN_MAX_CACHE_BYTES=21474836480
CDN_HOT_CACHE_BYTES=536870912
CDN_MAX_OBJECT_BYTES=1073741824
CDN_ORIGIN_TIMEOUT=30m
MINIO_REGION=us-east-1
ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
API_DOMAIN=api.testagram.site
MEDIA_DOMAIN=media.testagram.site
ACME_EMAIL=ops@example.com

# Staff console is served over HTTPS by Caddy. Generate with: openssl rand -hex 32
ADMIN_DOMAIN=ops.testagram.site
ADMIN_PUBLIC_URL=https://ops.testagram.site
ADMIN_SESSION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_KEY
# Shared only by trusted backend services over the private platform network. Generate independently from ADMIN_SESSION_KEY.
ADMIN_SERVICE_AUTH_KEY=REPLACE_WITH_ANOTHER_64_HEX_CHAR_RANDOM_KEY
ADMIN_COOKIE_SECURE=true
GRAFANA_URL=http://127.0.0.1:3000

# Grafana is bound to 127.0.0.1:3000; access remotely through an SSH tunnel.
GRAFANA_ADMIN_USER=testagram-ops
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_GRAFANA_PASSWORD

# Optional operator-controlled Alertmanager webhook. Blank means alerts are evaluated but not delivered externally.
# Treat this URL as a secret and never commit the real value.
ALERTMANAGER_WEBHOOK_URL=


# Per-account media quota; defaults to 2 GiB including active upload reservations.
MEDIA_USER_QUOTA_BYTES=2147483648
# Optional operator-only takedown token. Generate a long random value; blank disables quarantine actions.
MEDIA_MODERATION_TOKEN=


# Safaricom Daraja STK Push. Leave credentials blank until the business account is approved.
# Use sandbox for testing; switch to live only after callback verification and settlement smoke tests.
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://api.testagram.site/api/wallet/mpesa/callback


# Configure all three private object-store origins before enabling replication.
MEDIA_REPLICATION_ENABLED=false
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PRIVATE_BUCKET=
CLOUDFLARE_R2_PUBLIC_BUCKET=
CLOUDFLARE_R2_METADATA_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
B2_S3_ENDPOINT=
B2_S3_REGION=
B2_S3_BUCKET=
B2_S3_PRIVATE_BUCKET=
B2_S3_PUBLIC_BUCKET=
B2_S3_METADATA_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=

# Shared only between Fresh API and Backend; never expose to clients.
FRESH_MEDIA_INTERNAL_TOKEN=

# Dedicated Data Centre media API. Keep disabled until live B2/R2 + CDN acceptance passes.
FRESH_MEDIA_ENABLED=false
# When the Data Centre media profile is running on the shared testagram-platform network:
DATA_CENTRE_MEDIA_API_URL=http://media:8096
# Private Data Centre video service on the shared platform network; Flutter never calls this URL.
DATA_CENTRE_VIDEO_API_URL=http://video:8790
TESTAGRAM_VIDEO_NETWORK=testagram-video-private
# Must exactly match FRESH_DATA_CENTRE_INTERNAL_TOKEN in the Data Centre media service.
FRESH_DATA_CENTRE_INTERNAL_TOKEN=
# Distinct Backend-to-Data-Centre identity-evidence service token.
IDENTITY_EVIDENCE_DATA_CENTRE_INTERNAL_TOKEN=

# Native staff WebAuthn — use the exact Admin Console hostname/origin.
# Keep enrollment closed until the migration and independent owner bootstrap are approved.
TESTAGRAM_WEBAUTHN_RPID=
TESTAGRAM_WEBAUTHN_ORIGINS=
TESTAGRAM_STAFF_WEBAUTHN_ENROLLMENT_ENABLED=false
# Shared secret (32+ random bytes) for the private API-to-Admin Console readiness attestation.
TESTAGRAM_WEBAUTHN_READINESS_TOKEN=
# Private Docker service endpoint used by the Backend readiness probe; do not point this at a public host.
TESTAGRAM_ADMIN_CONSOLE_READINESS_URL=http://admin-console:8090/internal/webauthn/readiness
# Separate API-side identity intake gate; keep false until live Admin Console-to-Backend MFA acceptance.
TESTAGRAM_IDENTITY_REVIEW_WEBAUTHN_ENABLED=false

