{
  email {$ACME_EMAIL}
  admin off
  on_demand_tls {
    ask http://control-plane:8787/v1/hosting/tls/authorize
  }
  servers {
    # Only Cloudflare edge ranges may supply the client-IP headers. This lets
    # Caddy derive the visitor IP safely instead of rate-limiting every user
    # against a shared Cloudflare edge address.
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    trusted_proxies_strict
    client_ip_headers CF-Connecting-IP X-Forwarded-For
  }
}
{$API_DOMAIN} {
  @internal_observability path /metrics /readyz
  respond @internal_observability 404
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  # All public API traffic, including TV playback, must pass through Backend.
  # Keep liveness public for external release checks; dependency readiness
  # and metrics remain private and are checked from inside the deployment.
  handle /healthz {
    reverse_proxy api:8080 {
      header_up X-Real-IP {client_ip}
    }
  }
  handle {
    reverse_proxy api:8080 {
      header_up X-Real-IP {client_ip}
    }
  }
}
# The apex is the canonical Fediverse identity domain. The web frontend
# remains hosted on www.testagram.site; only ActivityPub discovery and
# protocol resources are routed to the private Federation service.
testagram.site {
  encode zstd gzip
  handle /_testagram/edge-health {
    respond `{"ok":true,"service":"testagram-apex-edge"}` 200
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  @activitypub path /.well-known/webfinger* /.well-known/nodeinfo* /nodeinfo/* /users/* /inbox /outbox /objects/*
  handle @activitypub {
    respond "Federation is disabled until locked G3 protocol acceptance passes." 503
  }
  handle {
    redir https://www.testagram.site{uri} 308
  }
}

{$MEDIA_DOMAIN} {
  @internal_observability path /readyz /metrics
  respond @internal_observability 404
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy media-cache:8081
}

# InstaBox exposes only high ports through its public-port gateway.
# This dedicated plaintext listener is reached through InstaBox HTTPS and
# Cloudflare; it serves the www frontend and preserves apex ActivityPub routes
# and redirects without exposing Caddy's management or internal health listeners.
:8443 {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  handle /_testagram/edge-health {
    respond `{"ok":true,"service":"testagram-apex-edge"}` 200
  }
  # Only the dedicated Cloudflare API Worker knows the shared edge token.
  # Do not route API traffic based on a spoofable Host/forwarding header alone.
  # InstaBox's public-port proxy may rewrite X-Forwarded-Host to its
  # generated origin hostname. The high-entropy shared token is the
  # authoritative API ingress selector; the Worker itself enforces the
  # public api.testagram.site hostname and supplies trusted forwarding data.
  @api_edge header X-Testagram-Edge-Token {$EDGE_PROXY_SHARED_TOKEN}
  handle @api_edge {
    reverse_proxy api:8080 {
      header_up Host api.testagram.site
      header_up X-Forwarded-Host api.testagram.site
      header_up X-Forwarded-Proto https
      header_up -X-Testagram-Edge-Token
    }
  }
  # The Worker strips untrusted forwarding headers and sets this value
  # from the incoming public hostname. The web origin shares this edge listener.
  @www_frontend header X-Forwarded-Host www.testagram.site
  handle @www_frontend {
    reverse_proxy flutter-web:8080
  }
  @activitypub path /.well-known/webfinger* /.well-known/nodeinfo* /nodeinfo/* /users/* /inbox /outbox /objects/*
  handle @activitypub {
    respond "Federation is disabled until locked G3 protocol acceptance passes." 503
  }
  handle {
    redir https://www.testagram.site{uri} 308
  }
}

{$ADMIN_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy admin-console:8090
}

# Tenant subdomains fall through to the private hosting control plane.
# On-demand TLS is guarded by the control-plane callback, which only permits
# DNS-verified and activated hostnames. Named API/media sites above stay specific.
:443 {
  tls {
    on_demand
  }
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy control-plane:8787
}
