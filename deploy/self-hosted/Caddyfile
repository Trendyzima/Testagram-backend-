{
  email {$ACME_EMAIL}
  admin off
  on_demand_tls {
    ask http://control-plane:8787/v1/hosting/tls/authorize
  }
}
{$API_DOMAIN} {
  @internal_observability path /metrics /readyz
  respond @internal_observability 404
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  # Video service is private on the shared Docker edge network. Route its
  # feed, HLS manifests/segments, likes, comments and creator endpoints over
  # the same HTTPS origin as Backend; never publish the container port.
  @video path /v1/feed /v1/videos /v1/videos/* /v1/channels /v1/channels/*
  handle @video {
    reverse_proxy video:8790
  }
  # Keep liveness public for external release checks; dependency readiness
  # and metrics remain private and are checked from inside the deployment.
  handle /healthz {
    reverse_proxy api:8080 {
      header_up X-Real-IP {remote_host}
    }
  }
  handle {
    reverse_proxy api:8080 {
      header_up X-Real-IP {remote_host}
    }
  }
}
# The apex is the canonical Fediverse identity domain. The web frontend
# remains hosted on www.testagram.site; only ActivityPub discovery and
# protocol resources are routed to the private Federation service.
testagram.site {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  @activitypub path /.well-known/webfinger /users/* /objects/*
  handle @activitypub {
    reverse_proxy federation-api:8081 {
      header_up Host testagram.site
      header_up X-Forwarded-Host testagram.site
      header_up X-Forwarded-Proto https
    }
  }
  handle {
    redir https://www.testagram.site{uri} 308
  }
}

{$MEDIA_DOMAIN} {
  @internal_observability path /readyz /metrics
  respond @internal_observability 404
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy media-cache:8081
}

# InstaBox exposes only high ports through its public-port gateway.
# This dedicated plaintext listener is reached through InstaBox HTTPS and
# Cloudflare; it serves the www frontend and preserves apex ActivityPub routes
# and redirects without exposing Caddy's management or internal health listeners.
:8443 {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  @edge_health path /_testagram/edge-health
  respond @edge_health `{"ok":true,"service":"testagram-apex-edge"}` 200
  # The Worker strips untrusted forwarding headers and sets this value
  # from the incoming public hostname. The web origin shares this edge listener.
  @www_frontend header X-Forwarded-Host www.testagram.site
  handle @www_frontend {
    reverse_proxy flutter-web:8080
  }
  @activitypub path /.well-known/webfinger /users/* /objects/*
  handle @activitypub {
    reverse_proxy federation-api:8081 {
      # InstaBox's public-port gateway connects through this generic :8443
      # listener, so the transport Host is the port URL. Federation must see
      # its canonical identity host exactly as it does on the direct 443 site.
      header_up Host testagram.site
      header_up X-Forwarded-Host testagram.site
      header_up X-Forwarded-Proto https
    }
  }
  handle {
    redir https://www.testagram.site{uri} 308
  }
}

{$ADMIN_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy admin-console:8090
}

# Tenant subdomains fall through to the private hosting control plane.
# On-demand TLS is guarded by the control-plane callback, which only permits
# DNS-verified and activated hostnames. Named API/media sites above stay specific.
:443 {
  tls {
    on_demand
  }
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy control-plane:8787
}
